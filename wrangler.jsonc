{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dcv-research-platform",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dcv-research",
      "database_id": "d8301616-d97a-417a-ba22-228cb3b74a6f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "APP_NAME": "DCV Research Platform",
    "AUTO_APPROVE": "true",
    "AUTO_PIPELINE": "true",
    "MAX_JOBS_PER_TICK": "1",
    "LAB_AUTO_START": "true",
    "LAB_DEADLINE_AT": "2026-10-30T14:59:59.000Z",
    "LAB_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "SIM_BATCH_SIZE": "180",
    "COMPUTE_EXECUTOR": "hybrid"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}

{
  "name": "dcv-research-platform",
  "version": "0.7.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create dcv-research --binding DB --update-config",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "tail": "wrangler tail",
    "queue:create": "wrangler queues create dcv-cdrs",
    "test": "node --test tests/*.test.mjs",
    "storage:verify": "node scripts/verify-storage-binding.mjs",
    "storage:snapshot": "node scripts/remote-project-guard.mjs snapshot",
    "storage:check": "node scripts/remote-project-guard.mjs check",
    "predev": "node scripts/prepare-lab-code.mjs",
    "predeploy": "node scripts/prepare-lab-code.mjs",
    "redesign:audit": "node scripts/audit-redesign.mjs",
    "lab:bundle": "node scripts/prepare-lab-code.mjs",
    "lab:test": "node --test tests/lab*.test.mjs",
    "research:actions": "node scripts/actions-runner.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.41.0"
  }
}
